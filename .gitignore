# ============================================================
# VFoot Arena — monorepo .gitignore
# ============================================================

# ---------- Secrets / local config (NEVER commit) ----------
.env
.env.*
!.env.example
**/config.properties
!**/config.properties.example
test/config.local.php

# ---------- Editors / OS ----------
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
Thumbs.db
desktop.ini
.DS_Store

# Tooling generated by IDE extensions (Java upgrade / modernize)
.github/java-upgrade/
.github/modernize/

# ---------- PHP — php/ ----------
vendor/
*.log
*.cache
php/public/uploads/

# ---------- Java — organisateur/ ----------
target/
bin/
out/
*.class
*.jar
*.war
*.ear
.classpath
.project
.settings/

# ---------- C++ / Qt — admin/ ----------
build/
build_*/
build-*/
admin/Debug/
admin/Release/
*.user
CMakeLists.txt.user*
*.o
*.obj
*.exe
*.out
*.a
*.lib
*.dll
*.so
*.pdb
*.ilk
*.cbp
*.layout
*.depend
